{
  "name": "v60-timer-card",
  "version": "1.0.0",
  "description": "Interactive Lovelace timer card for James Hoffmann's V60 pour-over recipe",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/v60-timer-card.ts --bundle --format=esm --outfile=v60-timer-card.js --minify",
    "watch": "esbuild src/v60-timer-card.ts --bundle --format=esm --outfile=v60-timer-card.js --watch --sourcemap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0",
    "custom-card-helpers": "^1.9.0"
  }
}
